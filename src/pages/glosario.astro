---
import Base from '../layouts/Base.astro';
import { glosario } from '../lib/glosario';
import { url } from '../lib/url';
const lista = [...glosario].sort((a, b) => a.termino.localeCompare(b.termino, 'es'));
---
<Base titulo="Glosario" seccion="glosario" descripcion="Los conceptos del libro, cada uno con la tesis que lo explica.">
  <article class="envoltura" style="margin:3rem auto 4rem">
    <p class="eyebrow">Glosario</p>
    <h1>Conceptos</h1>
    <dl class="glosario">
      {lista.map(g => (
        <div>
          <dt><a href={url(`/tesis/${g.slug}/`)}>{g.termino}</a></dt>
          <dd>{g.def}</dd>
        </div>
      ))}
    </dl>
  </article>
</Base>
<style>
  .glosario { margin: 2rem 0 0; }
  .glosario div { border-top: 1px solid var(--linea); padding: .9rem 0; }
  .glosario dt { font: 600 1.1rem/1.3 var(--f-titulo); margin-bottom: .25rem; }
  .glosario dt a { text-decoration: none; }
  .glosario dt a::after { content: ' ↗'; font: 500 .7em/1 var(--f-ui); color: var(--acento); }
  .glosario dd { margin: 0; color: var(--tinta-suave); font-size: 1.02rem; }
</style>
